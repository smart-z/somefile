mode: rule
# find-process-mode: off
keep-alive-idle: 900
keep-alive-interval: 600
log-level: warning
global-client-fingerprint: chrome
external-ui: ui
external-ui-url: https://github.com/MetaCubeX/Razord-meta/archive/refs/heads/gh-pages.zip
secret: "123456"
authentication:
  - nikki:917908
  - i:000000
tun:
  # dns-hijack:
  #   - tcp://any:53
  #   - udp://any:53
  enable: true
  auto-route: true
  auto-redirect: true
  auto-detect-interface: true
  device: nikki
  stack: mixed
  mtu: 1450
  gso: true
  gso-max-size: 65536
hosts:
  # 从原始配置迁移的时间同步服务器
  time.facebook.com:
    - 17.253.84.125
  time.android.com:
    - 17.253.84.125
  localhost:
    - 127.0.0.1
    - ::1
  11.com:
    - 192.168.31.1
  33.com:
    - 192.168.31.3
  ss.s:
    - 192.168.31.251
